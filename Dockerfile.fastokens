# Build a fastokens-enabled variant of the local vllm-custom-sm121 image.
#
# Usage:
#   docker build -f Dockerfile.fastokens \
#     -t vllm-custom-sm121:fastokens .
#
# Then point rank0.sh (or rank0_fastokens.sh) at the new tag and add
#   -e VLLM_USE_FASTOKENS=1
# to the docker run line.

FROM vllm-custom-sm121:latest

# Install fastokens. If your image doesn't ship `pip` on PATH, swap to
# `python -m pip install fastokens` or the path used in rank0.sh
# (/usr/local/lib/python3.12/dist-packages/...).
RUN pip install --no-cache-dir fastokens

# Optional: bake VLLM_USE_FASTOKENS=1 into the image so every container
# spawned from this tag picks it up without needing -e at run time.
# Remove this line if you'd rather set it explicitly in your boot scripts.
ENV VLLM_USE_FASTOKENS=1
